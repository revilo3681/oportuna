# Oportuna — configuración local
# Copia este archivo a .env y ajusta los secretos antes de desplegar.
# En producción: OPORTUNA_JWT_SECRET largo y aleatorio, admin con contraseña real.

OPORTUNA_ENVIRONMENT=development
OPORTUNA_PUBLIC_SITE_URL=http://localhost:8080
OPORTUNA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Base de datos del stack Docker
OPORTUNA_DATABASE_URL=postgresql+psycopg://oportuna:oportuna@localhost:55432/oportuna
OPORTUNA_REDIS_URL=redis://localhost:56379/0

OPORTUNA_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-32
OPORTUNA_SEED_ADMIN_EMAIL=admin@oportuna.local
OPORTUNA_SEED_ADMIN_PASSWORD=oportuna-admin-2026

# Política de publicación: solo lo verificado se publica automáticamente
OPORTUNA_AUTO_PUBLISH_MIN_CONFIDENCE=0.70
OPORTUNA_AUTO_PUBLISH_MAX_AGE_DAYS=21
OPORTUNA_DUPLICATE_REVIEW_THRESHOLD=0.78
OPORTUNA_DUPLICATE_MERGE_THRESHOLD=0.95

# Ingesta
OPORTUNA_INGEST_INTERVAL_MINUTES=360
OPORTUNA_VERIFY_INTERVAL_MINUTES=60
OPORTUNA_INGEST_MAX_ITEMS_PER_SOURCE=120
OPORTUNA_INGEST_MIN_INTERVAL_SECONDS=1.0
OPORTUNA_HTTP_USER_AGENT=OportunaBot/0.1 (+https://github.com/oportuna; opportunity research; contact: hello@oportuna.dev)

# Opcional: enriquecimiento con LLM (desactivado si está vacío)
OPORTUNA_LLM_ENABLED=true
OPORTUNA_LLM_BASE_URL=http://127.0.0.1:11434
OPORTUNA_LLM_MODEL=gemma4:12b-q4
OPORTUNA_LLM_EMBED_MODEL=nomic-embed-text:latest
OPORTUNA_LLM_TIMEOUT_SECONDS=180
OPORTUNA_LLM_MAX_CONTEXT_ITEMS=8
